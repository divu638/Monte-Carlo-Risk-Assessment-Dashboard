# ═══════════════════════════════════════════════════════════════
#  RiskGuard Pro — Enterprise Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Port and Flask Environment
PORT=5000
FLASK_ENV=production

# JWT Authentication Secret Key (Replace in Production)
JWT_SECRET=riskguard_super_secure_jwt_secret_key_2026_replace_in_prod

# Supabase Cloud Database (Optional: falls back to local SQLite if unreachable)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
